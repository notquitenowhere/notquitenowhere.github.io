---
import Base from '../../layouts/Base.astro';
import EssayRow from '../../components/EssayRow.astro';
import Banner from '../../components/Banner.astro';
import { BANNERS } from '../../consts';
import { allEssays, tagCounts } from '../../lib/collections';
import { readingMinutes, autoExcerpt } from '../../lib/text';

const essays = await allEssays();
const tags = await tagCounts();
---

<Base title="글" description="지금까지 쓴 에세이 전부.">
  <Banner {...BANNERS.essays}>
    {
      tags.length > 0 && (
        <div class="index__tags" style="margin-top:var(--space-m)">
          {tags.map(([t, n]) => (
            <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>
              {t} <span style="opacity:.55">{n}</span>
            </a>
          ))}
        </div>
      )
    }
  </Banner>

  <div class="page">
    <div class="index" style="margin-top:var(--space-m)">
      {
        essays.map((e, i) => (
          <EssayRow
            href={`/essays/${e.id}`}
            index={essays.length - i}
            title={e.data.title}
            excerpt={e.data.excerpt ?? autoExcerpt(e.body)}
            date={e.data.date}
            tags={e.data.tags}
            readingTime={readingMinutes(e.body)}
          />
        ))
      }
    </div>

    {
      essays.length === 0 && (
        <p style="padding-block:var(--space-l);color:var(--ink-3)">아직 올린 글이 없습니다.</p>
      )
    }
  </div>
</Base>
