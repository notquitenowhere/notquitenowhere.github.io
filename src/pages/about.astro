---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';

const entry = await getEntry('pages', 'about');
const { Content } = await render(entry!);
const { kicker, title, lede } = entry!.data;
---

<Base title={title} description={lede}>
  <Banner kicker={kicker} title={title} lede={lede} />

  <div class="essay-body page">
    <div class="prose">
      <Content />
      <div class="essay-end"><span>❦</span></div>
    </div>
  </div>
</Base>
