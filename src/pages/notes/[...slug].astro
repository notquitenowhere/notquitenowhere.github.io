---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Banner from '../../components/Banner.astro';
import { BANNERS } from '../../consts';
import { allNotes } from '../../lib/collections';

/** 노트는 개인 메모장이라 프로덕션 빌드에는 이 라우트 자체를 만들지 않는다. */
export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { slug: undefined } }];
}

const notes = await allNotes();
const rendered = await Promise.all(
  notes.map(async (n) => ({ note: n, Content: (await render(n)).Content })),
);
---

<Base title="노트" description="짧게 적어두는 것들 — 인용, 관찰, 아직 글이 되지 못한 생각.">
  <Banner {...BANNERS.notes} />

  <div class="page">
    {
      rendered.map(({ note, Content }) => (
        <article class="note-card reveal" id={note.id}>
          <div class="feature__meta">
            <FormattedDate date={note.data.date} style="short" />
            {note.data.tags.map((t) => (
              <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>
                {t}
              </a>
            ))}
          </div>

          <h3>{note.data.title}</h3>

          <div class="note-card__body prose" style="max-width:var(--w-text);margin-inline:0">
            <Content />
          </div>

          {note.data.source && (
            <p class="label">
              {'출처 '}
              {note.data.sourceUrl ? (
                <a class="link" href={note.data.sourceUrl} rel="noopener">
                  {note.data.source}
                </a>
              ) : (
                note.data.source
              )}
            </p>
          )}
        </article>
      ))
    }

    {
      notes.length === 0 && (
        <p style="padding-block:var(--space-l);color:var(--ink-3)">아직 노트가 없습니다.</p>
      )
    }
  </div>
</Base>
