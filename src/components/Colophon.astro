---
import { SITE, NAV } from '../consts';

const year = new Date().getFullYear();
const span = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
---

<footer class="colophon">
  <div class="colophon__grid">
    <div>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <ul>
        {
          SITE.links.map((l) => (
            <li>
              <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="colophon__bottom">
    <span class="label">© {span} {SITE.author}</span>
    <a class="label" href="https://creativecommons.org/licenses/by/4.0/deed.ko" rel="noopener">CC BY 4.0</a>
  </div>
</footer>
