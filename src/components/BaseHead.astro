---
import { SITE, THEME } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 소셜 카드 이미지 (사이트 루트 기준 경로) */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  accent?: string;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  accent,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유 카드 이미지. public/og-default.png 를 두면 자동으로 쓰입니다.
const ogImage = image ? new URL(image, Astro.site) : undefined;
const fullTitle = title === SITE.title ? `${SITE.title} — ${SITE.titleLatin}` : `${title} — ${SITE.title}`;

/** 색은 셋만 심으면 됩니다. 나머지 톤은 global.css 가 이걸 섞어 만듭니다. */
const palette = [
  `:root{--paper:${THEME.light.paper};--ink:${THEME.light.ink};--accent:${THEME.light.accent}}`,
  `:root[data-theme="dark"]{--paper:${THEME.dark.paper};--ink:${THEME.dark.ink};--accent:${THEME.dark.accent}}`,
  // 글마다 정한 강조색은 밝을 때와 어두울 때 모두에 적용합니다.
  accent ? `:root,:root[data-theme="dark"]{--accent:${accent}}` : '',
].join('');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonical} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:locale" content="ko_KR" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site)} />

<meta name="theme-color" content={THEME.light.paper} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME.dark.paper} media="(prefers-color-scheme: dark)" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Hahmlet:wght@300..700&display=swap"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<style set:html={palette} />

<!-- 테마 결정은 첫 페인트 전에. 깜빡임을 막는다. -->
<script is:inline>
  (function () {
    function apply() {
      let stored = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {
        /* 사생활 보호 모드 등 */
      }
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
    }

    apply();

    // 쪽을 넘길 때 ClientRouter 가 <html> 의 속성을 새 문서 것으로 갈아끼우면서
    // data-theme 이 날아간다. 바뀐 직후, 화면에 그려지기 전에 다시 심는다.
    document.addEventListener('astro:after-swap', apply);

    // 시스템 설정을 따라가는 중이라면(직접 고른 적이 없다면) 그 변화도 따라간다.
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      let stored = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {
        /* 무시 */
      }
      if (!stored) apply();
    });
  })();
</script>
