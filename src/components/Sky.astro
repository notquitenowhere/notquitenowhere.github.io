---
import { THEME } from '../consts';

/**
 * 배경 하늘.
 *
 * 그림 한 장으로 그립니다. 다만 그림을 그대로 깔지 않고 **마스크**로 씁니다.
 * 흑백 구름 그림에서 흰 곳에만 색이 칠해지므로,
 *   · 모양은 그림이 정하고
 *   · 색은 「페이지 → 색」에서 고른 두 색이 정합니다.
 * 그래서 테마를 바꾸면 하늘색도 같이 바뀝니다.
 *
 * 움직임은 transform 뿐입니다. 매 프레임 다시 그리지 않고 합성만 하므로
 * 앞의 SVG 필터 방식보다 훨씬 가볍습니다.
 *
 * 그림을 갈아끼우려면 public/images/ 에 흑백 이미지를 두고
 * src/data/site.json 의 theme.sky.image 를 바꾸면 됩니다.
 * 다시 뽑고 싶으면: node scripts/make-clouds.mjs --seed 12
 */
type SkySide = { base?: string; cloud?: string };
type SkyConf = {
  on?: boolean;
  strength?: number;
  image?: string;
  light?: SkySide;
  dark?: SkySide;
};

interface Props {
  /** 글 읽는 쪽에서는 하늘을 옅게 물린다. */
  quiet?: boolean;
}
const { quiet = false } = Astro.props;

const sky = (THEME as { sky?: SkyConf }).sky ?? {};
const on = sky.on !== false;
const full = typeof sky.strength === 'number' ? sky.strength : 1;
const strength = quiet ? full * 0.22 : full;
const image = sky.image || '/images/clouds.png';

const light = { base: '#4d63e6', cloud: '#f3c2ea', ...(sky.light ?? {}) };
const dark = { base: '#0f1538', cloud: '#8f7ce8', ...(sky.dark ?? {}) };

const vars = [
  `:root{--sky-base:${light.base};--sky-cloud:${light.cloud};--sky-img:url("${image}")}`,
  `:root[data-theme="dark"]{--sky-base:${dark.base};--sky-cloud:${dark.cloud}}`,
].join('');

/**
 * 세 겹. 배율과 흐름 주기를 서로 어긋나게 두면 (61·89·137초 처럼 서로
 * 나누어떨어지지 않는 수) 합쳐진 움직임이 한참 동안 같은 모양으로
 * 돌아오지 않아 무작위처럼 보입니다.
 */
const layers = [
  { id: 'a', size: '2400px', op: 0.9 },
  { id: 'b', size: '1450px', op: 0.4 },
  { id: 'c', size: '820px', op: 0.22 },
];
---

{
  on && (
    <>
      <style set:html={vars} />

      <div class="sky" aria-hidden="true" style={`--sky: ${strength}`}>
        <div class="sky__base" />
        {layers.map((l) => (
          <div class={`sky__drift sky__drift--${l.id}`}>
            <div class={`sky__cloud sky__cloud--${l.id}`} style={`--size:${l.size};--op:${l.op}`} />
          </div>
        ))}
        <div class="sky__glow" />
      </div>
    </>
  )
}

<style is:global>
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: var(--sky, 1);
    transition: opacity 600ms var(--ease);
  }

  .sky__base {
    position: absolute;
    inset: 0;
    background: var(--sky-base);
  }

  /* 가로로 흐르는 껍데기 + 세로로 흔들리는 알맹이.
     두 주기가 어긋나서 궤적이 반복처럼 보이지 않는다. */
  .sky__drift {
    position: absolute;
    inset: -25%;
    will-change: transform;
  }

  .sky__cloud {
    position: absolute;
    inset: 0;
    background: var(--sky-cloud);
    opacity: var(--op, 1);
    will-change: transform;

    -webkit-mask-image: var(--sky-img);
    mask-image: var(--sky-img);
    -webkit-mask-repeat: repeat;
    mask-repeat: repeat;
    -webkit-mask-size: var(--size) var(--size);
    mask-size: var(--size) var(--size);
  }

  .sky__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      70% 65% at 70% 18%,
      color-mix(in srgb, var(--sky-cloud) 34%, transparent),
      transparent 70%
    );
  }

  /* 서로 나누어떨어지지 않는 주기 — 겹쳐진 움직임이 오래 반복되지 않는다 */
  .sky__drift--a { animation: sky-x 181s ease-in-out infinite alternate; }
  .sky__cloud--a { animation: sky-y 97s ease-in-out infinite alternate; }
  .sky__drift--b { animation: sky-x 127s ease-in-out infinite alternate-reverse; }
  .sky__cloud--b { animation: sky-y 71s ease-in-out infinite alternate-reverse; }
  .sky__drift--c { animation: sky-x 89s linear infinite alternate; }
  .sky__cloud--c { animation: sky-y 53s ease-in-out infinite alternate; }

  @keyframes sky-x {
    from { transform: translate3d(-6%, 0, 0); }
    to { transform: translate3d(6%, 0, 0); }
  }
  @keyframes sky-y {
    from { transform: translate3d(0, -3%, 0) scale(1.02); }
    to { transform: translate3d(0, 3%, 0) scale(1.02); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky__drift, .sky__cloud { animation: none; }
  }

  /* 본문은 하늘 위에 */
  .site { position: relative; z-index: 1; }

  /*
   * 하늘이 짙게 깔린 쪽(배너·목록)에서는 글씨를 하늘 위에 밝게 얹는다.
   * 종이와 잉크만 바꾸면 괘선·흐린 글씨 같은 파생 색은 저절로 따라온다.
   */
  body.on-sky {
    --paper: var(--sky-base);
    --ink: #f6f5fb;
    --accent: var(--sky-cloud);
    --ink-2: color-mix(in srgb, var(--ink) 88%, var(--paper));
    --ink-3: color-mix(in srgb, var(--ink) 72%, var(--paper));
    --rule: color-mix(in srgb, var(--ink) 30%, var(--paper));
    --rule-soft: color-mix(in srgb, var(--ink) 18%, var(--paper));
  }
  body.on-sky::after { opacity: 0.03; }

  @media print { .sky { display: none !important; } }
</style>
