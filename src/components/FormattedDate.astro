---
interface Props {
  date: Date;
  /** 'long' 2026년 3월 4일 · 'short' 2026.03.04 · 'year' 2026 */
  style?: 'long' | 'short' | 'year';
  className?: string;
}

const { date, style = 'long', className = 'label' } = Astro.props;

const y = date.getFullYear();
const m = date.getMonth() + 1;
const d = date.getDate();

const text =
  style === 'long'
    ? `${y}년 ${m}월 ${d}일`
    : style === 'short'
      ? `${y}.${String(m).padStart(2, '0')}.${String(d).padStart(2, '0')}`
      : String(y);
---

<time class={className} datetime={date.toISOString().slice(0, 10)}>{text}</time>
