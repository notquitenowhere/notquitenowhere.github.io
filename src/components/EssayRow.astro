---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  index: number;
  title: string;
  excerpt?: string;
  date: Date;
  tags?: string[];
  readingTime?: number;
}

const { href, index, title, excerpt, date, tags = [], readingTime } = Astro.props;
---

<a class="index__row reveal" href={href}>
  <span class="index__num">{String(index).padStart(2, '0')}</span>

  <span>
    <h3 class="index__title">{title}</h3>
    {excerpt && <p class="index__excerpt">{excerpt}</p>}
    {
      tags.length > 0 && (
        <span class="index__tags" style="margin-top:.85rem">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </span>
      )
    }
  </span>

  <span class="index__side"><FormattedDate date={date} style="short" /></span>
  <span class="index__side"><span class="label">{readingTime ?? 1}분</span></span>
</a>
